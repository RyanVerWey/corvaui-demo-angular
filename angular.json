{
  "version": 1,
  "projects": {
    "corvaui-demo-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/corvaui-demo-angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "output": "."
                }
              ],
              "styles": [
                "node_modules/@corvaui/tokens/dist/tokens.css",
                "src/styles.css"
              ],
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "corvaui-demo-angular:build"
          }
        }
      }
    }
  }
}
